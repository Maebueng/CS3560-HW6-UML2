@startuml
title School Facility Rental - Activity

|Renter|
start

repeat
    :Choose facility, date, time, and event type;

    |Website|
    :Check availability;
    
    if (available?) then (yes)
        |Renter|
        :Enter contact info and submit request;

        |School Staff|
        :Check request;

        if (approved?) then (yes)
            |Payment Service|
            :Charge renter;

            if(payment successful?) then (yes)
                |Website|
                :Save booking;

                |Email Service|
                :Send confirmation email;
                stop
            else(payment fails)
                |Website|
                :Record payment failure;

                |Email Service|
                :Send payment failure email;
                stop
            endif
        else(rejected)
            |Website|
            :Record rejection;

            |Email Service|
            :Send rejection email;
            stop
        endif
    else(no)
        |Website|
        :Show not available;

        |Renter|
    endif
repeat while (choose another date?) is (yes)
->no;

|Renter|
stop

@enduml